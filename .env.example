# Signs session cookies and MCP tokens. Any long random string.
SESSION_SECRET=change-me-to-a-long-random-string

# The assistant calls Claude with your Anthropic API key (Claude Console, pay as you go).
ANTHROPIC_API_KEY=

# Optional: the model the assistant uses. Defaults to claude-sonnet-5-5.
# ASSISTANT_MODEL=claude-haiku-5-5
